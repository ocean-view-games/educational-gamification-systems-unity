# Unity generated directories (present if this package is developed in place
# inside a host project rather than consumed via Package Manager).
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Scaffolding Unity creates if this repo is mistakenly opened as a project
# root in the Hub. This repo is a UPM package: add it to a host project via
# Package Manager instead of opening it directly.
/Assets/
/ProjectSettings/
/Packages/

